{
  "name": "afify/faker-egy-names",
  "description": "Faker provider for grounded Egyptian names — the same generate() rules as faker-egy-names for Python.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "egy-names",
    "egyptian",
    "faker",
    "names",
    "arabic",
    "onomastics",
    "testing"
  ],
  "authors": [
    {
      "name": "Abdullah Afify",
      "email": "abdullah@afify.dev"
    }
  ],
  "homepage": "https://afify.co/egy-names",
  "support": {
    "issues": "https://github.com/AbdullahAfifyKhalil/egy-names/issues",
    "source": "https://github.com/AbdullahAfifyKhalil/faker-egy-names-php",
    "docs": "https://github.com/AbdullahAfifyKhalil/egy-names#readme"
  },
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-zlib": "*",
    "fakerphp/faker": "^1.23"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Afify\\FakerEgyNames\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Afify\\FakerEgyNames\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable"
}
