{
  "name": "egy-names",
  "version": "0.3.2",
  "description": "A production-grade Egyptian onomastic intelligence library for TypeScript & JavaScript \u2014 generate, translate, annotate, split, and analyze Egyptian names.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/src/data && cp src/data/names.json.gz dist/src/data/",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node dist/tests/smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdullahAfifyKhalil/egy-names.git"
  },
  "homepage": "https://github.com/AbdullahAfifyKhalil/egy-names#readme",
  "bugs": {
    "url": "https://github.com/AbdullahAfifyKhalil/egy-names/issues"
  },
  "keywords": [
    "egy-names",
    "egyptian",
    "names",
    "arabic",
    "onomastics",
    "nlp",
    "name-generator",
    "name-translation",
    "egypt"
  ],
  "author": "Abdullah Afify (Afify)",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.0.0"
  }
}
